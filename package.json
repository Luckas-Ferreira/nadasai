{
  "name": "nadasai",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "postbuild": "node scripts/flatten-prerender.mjs && node scripts/spa-fallback.mjs && node scripts/absolutize-assets.mjs && node scripts/preload-entry-chunks.mjs && node scripts/preload-fonts.mjs && node scripts/preload-dictionary.mjs && node scripts/generate-packs.mjs && node scripts/generate-ngsw.mjs",
    "og": "node scripts/generate-og-cards.mjs",
    "android:assets": "node scripts/generate-android-assets.mjs",
    "android:shots": "node scripts/generate-play-screenshots.mjs",
    "android:manifest": "node scripts/check-android-manifest.mjs",
    "store:check": "node scripts/check-listing.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "npm run build && playwright test",
    "e2e:fast": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "postinstall": "node scripts/fetch-model.mjs && node scripts/fetch-tessdata.mjs",
    "prebuild": "node scripts/fetch-model.mjs && node scripts/fetch-tessdata.mjs && node scripts/generate-sitemap.mjs && node scripts/generate-llms.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "llms": "node scripts/generate-llms.mjs",
    "check:templates": "node scripts/check-templates.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/platform-server": "^19.2.25",
    "@angular/router": "^19.2.0",
    "@angular/service-worker": "^19.2.25",
    "@angular/ssr": "^19.2.27",
    "@breezystack/lamejs": "^1.2.7",
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@fontsource/nunito": "^5.2.7",
    "cropperjs": "^1.6.1",
    "docx": "^9.7.1",
    "fflate": "^0.8.3",
    "file-saver": "^2.0.5",
    "jspdf": "^4.2.1",
    "onnxruntime-web": "^1.27.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.1.200",
    "rxjs": "~7.8.0",
    "tesseract.js": "^7.0.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.27",
    "@angular/cli": "^19.2.27",
    "@angular/compiler-cli": "^19.2.0",
    "@capacitor/cli": "^8.5.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/cropperjs": "^1.1.5",
    "@types/file-saver": "^2.0.7",
    "@types/jasmine": "~5.1.0",
    "esbuild": "^0.25.12",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.2",
    "typescript": "~5.7.2"
  },
  "optionalDependencies": {
    "fsevents": "^2.3.3"
  }
}
