{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/index.html", "/manifest.webmanifest", "/favicon.ico", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/media/**", "/*.webp", "/*.jpg", "/*.png", "/*.svg"]
      }
    },
    {
      "name": "ai",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/model/**", "/ort/**"]
      }
    },
    {
      "name": "pdf",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/pdfjs/**", "/tesseract/**", "/tessdata/**"]
      }
    }
  ]
}
