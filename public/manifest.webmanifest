{
  "id": "/",
  "name": "Nada Sai",
  "short_name": "Nada Sai",
  "description": "Processamento de arquivos que nunca saem do seu dispositivo.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "lang": "pt-BR",
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "logo_nadasai.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Editar PDF",
      "url": "/pt/pdf/editar"
    },
    {
      "name": "Juntar PDF",
      "url": "/pt/pdf/juntar"
    },
    {
      "name": "Remover fundo",
      "url": "/pt/imagem/remover-fundo"
    },
    {
      "name": "Gravar tela",
      "url": "/pt/video/gravar-tela"
    }
  ],
  "file_handlers": [
    {
      "action": "/pt/abrir",
      "accept": {
        "application/pdf": [".pdf"],
        "image/*": [".png", ".jpg", ".jpeg", ".webp", ".gif", ".bmp", ".avif"],
        "audio/*": [".mp3", ".wav", ".ogg", ".m4a", ".aac", ".flac"],
        "video/*": [".mp4", ".webm", ".mov", ".mkv"]
      }
    }
  ],
  "share_target": {
    "action": "/pt/abrir",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": ["application/pdf", "image/*", "audio/*", "video/*"]
        }
      ]
    }
  }
}
