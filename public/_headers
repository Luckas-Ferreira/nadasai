# Espelha os headers do `ng serve` (angular.json > serve > headers).
# Sem COOP/COEP não há SharedArrayBuffer, e a inferência da remoção de fundo
# cai para single-threaded (~6x mais lenta) sem erro nenhum — falha silenciosa.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# ---------------------------------------------------------------------------
# Cache
#
# Eterno é só o que tem hash no nome. O resto revalida.
#
# Isto existe porque o padrão do Cloudflare Pages é `max-age=0,
# must-revalidate` para TUDO — inclusive para `chunk-4CHL5S77.js`, cujo nome já
# É o hash do conteúdo e portanto nunca muda de significado. Ou seja: o site
# fazia uma revalidação por chunk, em toda visita, sem ganhar nada com isso. É o
# que torna tentador resolver no painel com uma regra ampla, e uma regra ampla
# é exatamente o que quebra a atualização do PWA.
#
# Declarado aqui, versionado, uma Cache Rule de "Respect origin TTL" passa a
# fazer a coisa certa sozinha. Fica um limite honesto: uma regra que
# SOBRESCREVE o Browser TTL ganha destas linhas de qualquer jeito — por isso
# sobrescrever TTL de navegador não pode valer para `/ngsw.json` nem para HTML.

# O sinal de atualização do app.
#
# `AppUpdateService` chama `checkForUpdate()`, e o ngsw responde buscando este
# arquivo. Uma cópia velha aqui significa que o deploy novo não existe para quem
# já visitou o site: fica preso na versão anterior até limpar cache na mão. É o
# pior modo de falha de um PWA, porque some em janela anônima e some para quem
# testa pela primeira vez — só atinge quem já é usuário.
/ngsw.json
  Cache-Control: no-cache

# O worker e seu par de segurança. `no-cache` é revalidar, não "não guardar": o
# 304 continua barato, e a troca de versão continua imediata.
/ngsw-worker.js
  Cache-Control: no-cache
/safety-worker.js
  Cache-Control: no-cache
/worker-basic.min.js
  Cache-Control: no-cache

# O shell da raiz e as 74 páginas do prerender. Cada HTML referencia chunks com
# hash no nome, então um HTML velho aponta para arquivos que o deploy novo não
# tem — tela branca, e nenhum erro que diga isso. As rotas são servidas sem
# extensão (`/pt/imagem/cortar`), então o casamento é pelo prefixo de idioma.
/
  Cache-Control: no-cache
/pt
  Cache-Control: no-cache
/en
  Cache-Control: no-cache
/pt/*
  Cache-Control: no-cache
/en/*
  Cache-Control: no-cache

# Estes SIM: `outputHashing: all` põe o hash do conteúdo no nome, então um byte
# diferente é um arquivo diferente, e `immutable` é literalmente verdade.
/chunk-*
  Cache-Control: public, max-age=31536000, immutable
/main-*
  Cache-Control: public, max-age=31536000, immutable
/polyfills-*
  Cache-Control: public, max-age=31536000, immutable
/styles-*
  Cache-Control: public, max-age=31536000, immutable
/media/*
  Cache-Control: public, max-age=31536000, immutable

# Assets de runtime com nome ESTÁVEL: os pesos do modelo, o onnxruntime, o
# pdf.js e o tesseract. O nome não carrega hash, então `immutable` seria mentira
# — mas uma semana é seguro mesmo assim, porque quem tem service worker nunca
# depende deste cache: ao ver hash divergente no manifesto, o ngsw refaz o
# download com `?ngsw-cache-bust=`, que fura cache de navegador e de borda.
/model/*
  Cache-Control: public, max-age=604800
/ort/*
  Cache-Control: public, max-age=604800
/pdfjs/*
  Cache-Control: public, max-age=604800
/tesseract/*
  Cache-Control: public, max-age=604800
/tessdata/*
  Cache-Control: public, max-age=604800
